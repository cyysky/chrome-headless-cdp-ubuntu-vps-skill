[Unit]
Description=CDP manage - token-authenticated control plane for headless Chrome
Documentation=https://developer.chrome.com/docs/devtools/remote-debugging/
After=network-online.target chrome-headless.service
Wants=network-online.target

[Service]
Type=simple
User=server
Group=server
EnvironmentFile=/etc/cdp-manage/env
WorkingDirectory=/opt/cdp-manage
ExecStart=/usr/local/bin/node /opt/cdp-manage/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
